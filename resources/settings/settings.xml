<settings>
    <setting propertyKey="@Properties.AccentColor" title="@Strings.AccentColorTitle">
        <settingConfig type="list">
            <listEntry value="0xFF5500">@Strings.ColorOrange</listEntry>
            <listEntry value="0xFF0000">@Strings.ColorRed</listEntry>
            <listEntry value="0x00AA55">@Strings.ColorGreen</listEntry>
            <listEntry value="0x00AAFF">@Strings.ColorBlue</listEntry>
            <listEntry value="0xFFAA00">@Strings.ColorYellow</listEntry>
            <listEntry value="0xFFFFFF">@Strings.ColorWhite</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.ShowSeconds" title="@Strings.ShowSecondsTitle">
        <settingConfig type="boolean"/>
    </setting>

    <setting propertyKey="@Properties.ShowGoalRing" title="@Strings.ShowGoalRingTitle">
        <settingConfig type="boolean"/>
    </setting>

    <setting propertyKey="@Properties.LeftMetric" title="@Strings.LeftMetricTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.MetricHeartRate</listEntry>
            <listEntry value="1">@Strings.MetricSteps</listEntry>
            <listEntry value="2">@Strings.MetricBattery</listEntry>
            <listEntry value="3">@Strings.MetricBodyBattery</listEntry>
            <listEntry value="4">@Strings.MetricStress</listEntry>
            <listEntry value="5">@Strings.MetricCalories</listEntry>
            <listEntry value="6">@Strings.MetricFloors</listEntry>
            <listEntry value="7">@Strings.MetricIntensity</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.MiddleMetric" title="@Strings.MiddleMetricTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.MetricHeartRate</listEntry>
            <listEntry value="1">@Strings.MetricSteps</listEntry>
            <listEntry value="2">@Strings.MetricBattery</listEntry>
            <listEntry value="3">@Strings.MetricBodyBattery</listEntry>
            <listEntry value="4">@Strings.MetricStress</listEntry>
            <listEntry value="5">@Strings.MetricCalories</listEntry>
            <listEntry value="6">@Strings.MetricFloors</listEntry>
            <listEntry value="7">@Strings.MetricIntensity</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.RightMetric" title="@Strings.RightMetricTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.MetricHeartRate</listEntry>
            <listEntry value="1">@Strings.MetricSteps</listEntry>
            <listEntry value="2">@Strings.MetricBattery</listEntry>
            <listEntry value="3">@Strings.MetricBodyBattery</listEntry>
            <listEntry value="4">@Strings.MetricStress</listEntry>
            <listEntry value="5">@Strings.MetricCalories</listEntry>
            <listEntry value="6">@Strings.MetricFloors</listEntry>
            <listEntry value="7">@Strings.MetricIntensity</listEntry>
        </settingConfig>
    </setting>
</settings>
